{
  "name": "rf-field-notes-qa",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node scripts/qa/doctor.mjs",
    "test:contract": "node --test scripts/qa/site-contract.test.mjs",
    "check:site": "node scripts/qa/site-contract.mjs --site _site --stage baseline",
    "qa:browser": "playwright test --config scripts/qa/playwright.config.mjs",
    "qa:lighthouse": "node scripts/qa/lighthouse.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "axe-core": "4.10.3",
    "lighthouse": "12.8.2"
  }
}
